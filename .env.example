# Server-only Asana personal access token. Never expose this with a
# NEXT_PUBLIC_ prefix and never commit the real value.
ASANA_ACCESS_TOKEN=

# Asana project GID for the active 2026 tax season.
ASANA_PROJECT_GID=

# Shared staff-access password for the Version 1.0 management-testing release.
# Use at least 12 characters and store the real value only in the server environment.
SALINAS_STAFF_PASSWORD=

# Random signing secret for staff sessions. Use at least 32 characters.
# Generate a unique production value with: openssl rand -base64 32
SALINAS_AUTH_SECRET=

# Server-only PostgreSQL connection string for the persistence foundation.
# Existing application readers remain code-backed and do not require this yet.
# Never use a NEXT_PUBLIC_ prefix or commit a real connection string.
DATABASE_URL=postgresql://salinas_app:replace-with-local-password@localhost:5432/salinas_os
